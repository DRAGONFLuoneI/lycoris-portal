flowchart TD
    START([Начало]) --> A["Пользователь открывает<br/>форму заявки"]
    A --> B{Пользователь<br/>авторизован?}

    B -->|Да| C["Поля формы заполняются<br/>данными профиля"]
    B -->|Нет| D["Форма остаётся пустой"]

    C --> E["Пользователь заполняет<br/>и правит данные"]
    D --> E

    E --> F["Нажатие кнопки<br/>«Отправить заявку»"]
    F --> G["Валидация данных формы"]

    G --> H{Имя заполнено<br/>корректно?}
    H -->|Нет| I["Подсветить поле «Имя»"]
    I --> E

    H -->|Да| J{Телефон или Telegram<br/>в верном формате?}
    J -->|Нет| K["Подсветить поле «Контакт»"]
    K --> E

    J -->|Да| L{Регион указан?}
    L -->|Нет| M["Подсветить поле «Регион»"]
    M --> E

    L -->|Да| N{Согласие на обработку<br/>данных получено?}
    N -->|Нет| O["Подсветить чек-бокс"]
    O --> E

    N -->|Да| P["Формирование объекта заявки:<br/>данные + дата + страница"]
    P --> Q{Пользователь<br/>авторизован?}

    Q -->|Да| R["Привязать заявку<br/>к user_id"]
    Q -->|Нет| S["user_id = NULL<br/>анонимная заявка"]

    R --> T["Сохранение записи<br/>в таблицу leads"]
    S --> T

    T --> U{Сохранение<br/>успешно?}
    U -->|Нет| V["Показать сообщение<br/>об ошибке"]
    V --> E

    U -->|Да| W["Присвоить статус «Новая»"]
    W --> X["Показать окно<br/>«Ваша заявка принята»"]
    X --> Y["Заявка появляется<br/>в панели администратора"]
    Y --> Z([Конец])

    style START fill:#1A1A1A,color:#fff
    style Z fill:#1A1A1A,color:#fff
    style G fill:#fff3cd,stroke:#C9A227
    style T fill:#e5f5e5,stroke:#3d5c3a
    style X fill:#ffe5e5,stroke:#E60000
